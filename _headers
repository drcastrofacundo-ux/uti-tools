# Cabeceras de Netlify.
#
# Netlify no reconoce la extension .webmanifest y la sirve como
# application/octet-stream. Chrome lo tolera, pero Firefox rechaza un manifest
# con MIME incorrecto y la app deja de poder instalarse.
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# El service worker no debe quedar cacheado por el navegador: es el archivo que
# decide como se sirve todo lo demas, asi que tiene que poder actualizarse.
/sw.js
  Cache-Control: no-cache
